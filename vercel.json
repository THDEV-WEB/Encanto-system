{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/encanto", "permanent": false }
  ],
  "rewrites": [
    { "source": "/encanto/download", "destination": "/encanto/index.html" }
  ],
  "headers": [
    {
      "source": "/encanto/downloads/Encanto.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    }
  ]
}
